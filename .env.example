# Local SQLite works without these variables. For Vercel, DATABASE_URL is required.
# Prefer a pooled PostgreSQL connection URL from your provider, with TLS enabled.
# Example cloud value: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
# Leave 0 for local HTTP. Vercel automatically uses Secure cookies over HTTPS.
STMS_SECURE_COOKIE=0
# Used only by `python manage.py init` when creating a fresh production database:
STMS_ADMIN_NAME=Administrator
STMS_ADMIN_EMAIL=replace-with-your-email@example.com
STMS_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional NVIDIA NIM AI planner. Never commit your real key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
